# Environment configuration — copy to .env and fill in values for local dev.
# In production, these values are set via Azure App Service → Application Settings.

# App
APP_ENV=local
LOG_LEVEL=INFO

# SendGrid
SENDGRID_API_KEY=
SENDGRID_REPLY_TO_EMAIL=

# Auth service
AUTH_URL=
AUTH_EMAIL=
AUTH_PASSWORD=

# CRM endpoints
CRM_BASE_URL=
CRM_EVENT_ENDPOINT=
CRM_INBOUND_ENDPOINT=

# Public base URL for click tracking
PUBLIC_BASE_URL=

# Telnyx (SMS — not in use currently)
TELNYX_API_KEY=
TELNYX_FROM_NUMBER=

# JWT — shared HS256 secret with PracticeEHR .NET CRM backend
JWT_SECRET_KEY=
