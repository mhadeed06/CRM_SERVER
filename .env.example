# Environment configuration — copy to .env and fill in values for local dev.
# In production, these values are set via Azure App Service → Application Settings.

# App
APP_ENV=local
LOG_LEVEL=INFO

# AWS SES (outbound email + event notifications via SNS)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_SES_FROM_EMAIL=noreply@crm.practiceehr.com
AWS_SES_FROM_NAME=PracticeEHR CRM
AWS_SES_REPLY_TO_EMAIL=inbox@reply.crm.practiceehr.com
# Optional — SES configuration set that publishes events to SNS.
# Leave empty for send-only testing without event notifications.
AWS_SES_CONFIGURATION_SET=

# S3 location where SES stores raw inbound emails.
# The inbound webhook fetches the raw MIME from here using mail.messageId.
AWS_SES_INBOUND_BUCKET=pehr-crm-ses-inbound-emails
AWS_SES_INBOUND_PREFIX=crm-replies/

# Dedicated IAM user for S3 reads (separate from the SES-send user for security).
# If unset, S3 client falls back to AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY.
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=

# Auth service
AUTH_URL=
AUTH_EMAIL=
AUTH_PASSWORD=

# CRM endpoints
CRM_BASE_URL=
CRM_EVENT_ENDPOINT=
CRM_INBOUND_ENDPOINT=

# Public base URL for click tracking
PUBLIC_BASE_URL=

# Telnyx (SMS — not in use currently)
TELNYX_API_KEY=
TELNYX_FROM_NUMBER=

# JWT — shared HS256 secret with PracticeEHR .NET CRM backend
JWT_SECRET_KEY=

# Independent secret for signing unsubscribe tokens in outbound email links.
# Only known to this service; not shared with CRM.
UNSUBSCRIBE_SECRET_KEY=

# CRM endpoint that receives unsubscribe notifications from us.
CRM_UNSUBSCRIBE_ENDPOINT=/Crm/Patient/Unsubscribe

# Comma-separated list of origins allowed to call the API from a browser (CORS).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
